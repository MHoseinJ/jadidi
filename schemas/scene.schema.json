{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Game Scene",
  "description": "Schema for scene JSON files loaded by SceneManager",
  "type": "object",
  "properties": {
    "physics": {
      "type": "object",
      "description": "Global physics settings for the scene",
      "properties": {
        "gravity": {
          "type": "object",
          "properties": {
            "x": { "type": "number", "default": 0.0 },
            "y": { "type": "number", "default": -9.8 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "objects": {
      "type": "array",
      "description": "List of GameObjects in the scene",
      "items": { "$ref": "#/definitions/GameObject" }
    }
  },
  "required": ["objects"],
  "additionalProperties": false,
  "definitions": {
    "GameObject": {
      "type": "object",
      "description": "A single GameObject",
      "properties": {
        "name": { "type": "string", "description": "The name of the GameObject" },
        "tag": { "type": "string", "description": "Optional tag for filtering/finding" },
        "id": { 
          "type": "integer", 
          "description": "DEPRECATED: Auto-generated by the engine. Do not set manually.",
          "deprecated": true 
        },
        "transform": { "$ref": "#/definitions/Transform" },
        "sprite": { "$ref": "#/definitions/Sprite" },
        "animator": { "$ref": "#/definitions/Animator" },
        "rigidbody": { "$ref": "#/definitions/Rigidbody" },
        "text": { "$ref": "#/definitions/Text" },
        "boxCollider": { "$ref": "#/definitions/BoxCollider" },
        "button": { "$ref": "#/definitions/Button" },
        "audio": { "$ref": "#/definitions/Audio" }
      },
      "required": ["name", "transform"],
      "additionalProperties": false
    },
    "Transform": {
      "type": "object",
      "description": "Mandatory Transform component",
      "properties": {
        "position": {
          "type": "object",
          "properties": {
            "x": { "type": "number", "default": 0.0 },
            "y": { "type": "number", "default": 0.0 }
          },
          "additionalProperties": false
        },
        "scale": {
          "type": "object",
          "properties": {
            "x": { "type": "number", "default": 1.0 },
            "y": { "type": "number", "default": 1.0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "Sprite": {
      "type": "object",
      "properties": {
        "texture": { "type": "string", "description": "Path to the texture file" },
        "z_index": { "type": "integer", "default": 0 },
        "color": {
          "type": "object",
          "properties": {
            "r": { "type": "integer", "minimum": 0, "maximum": 255 },
            "g": { "type": "integer", "minimum": 0, "maximum": 255 },
            "b": { "type": "integer", "minimum": 0, "maximum": 255 },
            "a": { "type": "integer", "minimum": 0, "maximum": 255 }
          },
          "additionalProperties": false
        },
        "src": {
          "type": "object",
          "description": "Source rectangle for sprite sheet slicing",
          "properties": {
            "x": { "type": "integer" },
            "y": { "type": "integer" },
            "w": { "type": "integer" },
            "h": { "type": "integer" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "Animator": {
      "type": "object",
      "properties": {
        "speed": { "type": "number", "default": 1.0 },
        "playing": { "type": "boolean", "default": true },
        "play": { "type": "string", "description": "Name of the starting animation" }
      },
      "additionalProperties": false
    },
    "Rigidbody": {
      "type": "object",
      "properties": {
        "velocity": {
          "type": "object",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" }
          },
          "additionalProperties": false
        },
        "density": { "type": "number", "default": 1.0 },
        "friction": { "type": "number", "default": 1.0 },
        "isDynamic": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "Text": {
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "color": {
          "type": "object",
          "properties": {
            "r": { "type": "integer", "minimum": 0, "maximum": 255 },
            "g": { "type": "integer", "minimum": 0, "maximum": 255 },
            "b": { "type": "integer", "minimum": 0, "maximum": 255 },
            "a": { "type": "integer", "minimum": 0, "maximum": 255 }
          },
          "additionalProperties": false
        },
        "size": { "type": "integer", "description": "Font size", "default": 16 },
        "font": { "type": "string", "description": "Font name", "default": "font" }
      },
      "additionalProperties": false
    },
    "BoxCollider": {
      "type": "object",
      "description": "Axis-Aligned Bounding Box Collider",
      "properties": {
        "w": { "type": "number", "description": "Width of the collider" },
        "h": { "type": "number", "description": "Height of the collider" }
      },
      "additionalProperties": false
    },
    "Button": {
      "type": "object",
      "properties": {
        "zOrder": { "type": "integer", "default": 0 },
        "functions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "description": "Name of the Lua function" },
              "mouse": { "type": "integer", "description": "Mouse button index (0-based)" }
            },
            "required": ["name", "mouse"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "Audio": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Name/Path of the audio file" },
        "loops": { "type": "integer", "default": 1 },
        "volume": { "type": "integer", "default": 128 },
        "spatial": { "type": "boolean", "default": false },
        "maxDistance": { "type": "number", "default": 5000.0 },
        "channel": { "type": "integer", "default": -1 }
      },
      "additionalProperties": false
    }
  }
}